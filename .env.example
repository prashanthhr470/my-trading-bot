# HAFNOT AI Trading Agent - environment configuration template
#
# Copy this file to ".env" and fill in your own real values.
# NEVER commit the real ".env" file - it is excluded via .gitignore.
#
# Where to get cTrader Open API credentials:
#   1. Log in at https://openapi.ctrader.com/apps
#   2. Create an application to get CTRADER_CLIENT_ID / CTRADER_CLIENT_SECRET.
#   3. Register a redirect URI matching CTRADER_REDIRECT_URI below.
#   4. Run the one-time OAuth flow: app\openapi\auth\oauth.py
#      (opens a browser, completes the login, saves tokens to
#      data\ctrader_oauth_tokens.json).
#   5. Run app\openapi\auth\account_auth.py to authorize and select the
#      DEMO trading account. It writes data\ctrader_authorized_account.json.

# --- cTrader Open API application credentials ---
CTRADER_CLIENT_ID=your_ctrader_client_id
CTRADER_CLIENT_SECRET=your_ctrader_client_secret
CTRADER_REDIRECT_URI=http://127.0.0.1:8080/callback

# --- cTrader account / environment ---
# CTRADER_OPENAPI_HOST must be "demo" for all paper/demo validation stages.
# LIVE TRADING MUST REMAIN DISABLED until you deliberately and manually
# change this AND the hard safety flags below, after a successful, fully
# verified DEMO validation period.
CTRADER_OPENAPI_HOST=demo

# --- Hard safety flags ---
# These are also enforced in code (hafnot_final_runtime.py sets them
# unconditionally at process start), but are kept here for visibility
# and for any tooling that reads them directly from the environment.
DRY_RUN=true
PAPER_TRADING=true
LIVE_EXECUTION=false
BROKER_ORDERS=0
AI_DIRECT_EXECUTION=false
READ_ONLY=true

# Real DEMO order placement (app\openapi\execution\native_order_execution.py)
# is a SEPARATE, deliberately-disabled capability - it is never invoked by
# the always-on 24/7 paper loop. Set to "true" only when you yourself run
# hafnot_demo_order_smoke_test.py to verify one real DEMO order round-trip.
# The worker independently refuses to run against any non-DEMO/isLive
# account regardless of this flag.
DEMO_ORDER_EXECUTION_ENABLED=false

# --- AI reasoning provider (Ollama / Qwen3) ---
# NOT read from this file - app\ai\provider.py currently hardcodes the
# endpoint and model. Documented here so you know what must be running:
#   Ollama must be running locally and reachable at http://localhost:11434
#   with the "qwen3:0.6b" model pulled (run: ollama pull qwen3:0.6b).
# The AI is advisory-only; Python retains final authority via the
# deterministic decision gate and execution safety gate.
